<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wordle Game</title>
    <style>
        :root { --color-correct: #6aaa64; --color-present: #c9b458; --color-absent: #787c7e; --color-tile-border: #d3d6da; }
        body { font-family: 'Helvetica Neue', Arial, sans-serif; display: flex; flex-direction: column; align-items: center; height: 100vh; margin: 0; }
        #board { display: grid; grid-template-rows: repeat(6, 1fr); gap: 5px; margin-top: 20px; }
        .row { display: grid; grid-template-columns: repeat(5, 1fr); gap: 5px; }
        .tile { width: 50px; height: 50px; border: 2px solid var(--color-tile-border); display: flex; justify-content: center; align-items: center; font-size: 2rem; font-weight: bold; text-transform: uppercase; }
        .tile[data-state="correct"] { background-color: var(--color-correct); border-color: var(--color-correct); color: white; }
        .tile[data-state="present"] { background-color: var(--color-present); border-color: var(--color-present); color: white; }
        .tile[data-state="absent"] { background-color: var(--color-absent); border-color: var(--color-absent); color: white; }
        #keyboard { margin-top: 20px; display: flex; flex-direction: column; gap: 8px; }
        .key-row { display: flex; gap: 6px; }
        .key { padding: 10px 15px; background-color: #d3d6da; border: none; border-radius: 4px; cursor: pointer; text-transform: uppercase; }
    </style>
</head>
<body>
    <div id="board"></div>
    <div id="keyboard"></div>
    <script>
        const wordList = ["REACT", "APPLE", "SMART", "PLANT", "LIGHT"];
        let targetWord = wordList[Math.floor(Math.random() * wordList.length)];
        let currentTry = 0, currentTile = 0, currentGuess = "";
        const board = document.getElementById("board");
        // Initialize board
        for (let i = 0; i < 6; i++) {
            const row = document.createElement("div"); row.className = "row";
            for (let j = 0; j < 5; j++) {
                const tile = document.createElement("div"); tile.className = "tile"; tile.id = `r${i}t${j}`;
                row.appendChild(tile);
            }
            board.appendChild(row);
        }
        // Handle input
        document.addEventListener("keydown", (e) => {
            if (currentTry >= 6) return;
            if (e.key === "Enter" && currentGuess.length === 5) {
                checkGuess();
            } else if (e.key === "Backspace" && currentGuess.length > 0) {
                currentGuess = currentGuess.slice(0, -1);
                document.getElementById(`r${currentTry}t${--currentTile}`).textContent = "";
            } else if (/^[a-zA-Z]$/.test(e.key) && currentGuess.length < 5) {
                document.getElementById(`r${currentTry}t${currentTile++}`).textContent = e.key.toUpperCase();
                currentGuess += e.key.toUpperCase();
            }
        });
        function checkGuess() {
            let tempTarget = targetWord.split("");
            let rowTiles = [];
            // Basic matching logic
            for (let i = 0; i < 5; i++) {
                const tile = document.getElementById(`r${currentTry}t${i}`);
                if (currentGuess[i] === targetWord[i]) {
                    tile.setAttribute("data-state", "correct");
                    tempTarget[i] = null;
                }
            }
            for (let i = 0; i < 5; i++) {
                const tile = document.getElementById(`r${currentTry}t${i}`);
                if (tile.getAttribute("data-state") === "correct") continue;
                if (tempTarget.includes(currentGuess[i])) {
                    tile.setAttribute("data-state", "present");
                    tempTarget[tempTarget.indexOf(currentGuess[i])] = null;
                } else {
                    tile.setAttribute("data-state", "absent");
                }
            }
            if (currentGuess === targetWord) alert("Win!");
            currentTry++; currentGuess = ""; currentTile = 0;
            if (currentTry === 6 && currentGuess !== targetWord) alert("Game Over! Word: " + targetWord);
        }
    </script>
</body>
</html>
